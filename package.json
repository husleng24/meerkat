{
    "name": "meerkat",
    "version": "0.1.1",
  "license": "MIT",
    "main": "out/main/index.js",
    "private": true,
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:sqlite": "node scripts/run-electron.cjs scripts/verify-sqlite.cjs",
        "verify:electron": "node scripts/run-electron.cjs scripts/hello.cjs",
        "rebuild:native": "electron-builder install-app-deps",
        "run-once": "tsx scripts/run-once.ts",
        "prep-schedule": "tsx scripts/prep-schedule.ts",
        "seed": "tsx scripts/run-once.ts",
        "compose-once": "tsx scripts/compose-once.ts",
        "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
        "dist:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml",
        "verify:packaged": "node scripts/run-electron.cjs scripts/verify-packaged.cjs",
        "verify:app": "electron . --verify --no-sandbox",
        "verify:node": "tsx scripts/selfcheck.ts",
        "e2e": "tsx scripts/e2e.ts"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "38.8.6",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "jsdom": "^30.1.3",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "better-sqlite3": "13.0.3",
        "fast-xml-parser": "^5.11.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "undici": "^8.12.3",
        "zod": "^4.6.7"
    },
    "description": "Meerkat · 替你盯着 AI 领域真正变了什么",
    "author": "Meerkat",
    "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
